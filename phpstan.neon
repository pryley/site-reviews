includes:
    - vendor/pryley/wp-plugin-tooling/phpstan/base.neon
parameters:
  bootstrapFiles:
    - tests/phpstan/bootstrap.php
    - tests/stubs/action-scheduler.php
    - tests/stubs/akismet.php
    - tests/stubs/breakdance.php
    - tests/stubs/bricks.php
    - tests/stubs/buddyboss.php
    - tests/stubs/divi.php
    - tests/stubs/elementor.php
    - tests/stubs/elementorpro.php
    - tests/stubs/flatsome.php
    - tests/stubs/fusion-builder.php
    - tests/stubs/gamipress.php
    - tests/stubs/lpfw.php
    - tests/stubs/mycred.php
    - tests/stubs/multilingualpress.php
    - tests/stubs/nitropack.php
    - tests/stubs/polylang.php
    - tests/stubs/profilepress.php
    - tests/stubs/sg-cachepress.php
    - tests/stubs/surecart.php
    - tests/stubs/swift-performance-lite.php
    - tests/stubs/ultimate-member.php
    - tests/stubs/w3-total-cache.php
    - tests/stubs/wlpr.php
    - tests/stubs/woocommerce.php
    - tests/stubs/woorewards.php
    - tests/stubs/wp-loyalty-rules.php
    - tests/stubs/wp-optimize.php
    - tests/stubs/wp-rocket.php
    - tests/stubs/wp-super-cache.php
    - tests/stubs/wpbakery.php
    - tests/stubs/wpml.php
    - helpers.php
    - autoload.php
  ignoreErrors:
    -
      identifier: staticMethod.internal
    # These are ArrayObject classes
    - '#Access to an undefined property GeminiLabs\\SiteReviews\\Contracts\\(Field|Plugin|Shortcode)Contract::(.+)#'
    # Technically, these errors are correct. However, since this is a third-party package we will ignore them for now
    - '#Call to an undefined method ActionScheduler_Schedule::(get_recurrence|get_date)\(\).#'
    # get_views() is in the $compat_methods array for public access, leave this for now
    - '#Call to protected method get_views\(\) of class WP_Posts_List_Table.#'
    # This usage is acceptable in the project
    - '#Unsafe usage of new static\(\).#'
    # Breakdance documents these as @psalm-type ARRAY aliases (plugin/psalm-types/render.php
    # upstream); the stubs carry the docblocks verbatim and phpstan reads the aliases as classes
    - '#invalid return type Breakdance\\Elements\\ElementDependenciesAndConditions#'
    - '#should return array but returns Breakdance\\Elements\\Control#'
    - '#PHPDoc tag @method for method GeminiLabs\\SiteReviews\\Modules\\Schema\\(.+)#'
  paths:
    - assets/breakdance
    - config
    - plugin
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
    - vendors/woocommerce/action-scheduler/functions.php
  universalObjectCratesClasses:
    - GeminiLabs\SiteReviews\Arguments
    - GeminiLabs\SiteReviews\Modules\Html\Field
    - GeminiLabs\SiteReviews\Modules\Html\Form
    # LPFW's Abstract_Main_Plugin_Class exposes its models via __get; the stub
    # mirrors upstream, which documents no @property types for them
    - LPFW
