<?xml version="1.0"?>
<ruleset name="Custom Standard" namespace="GeminiLabs\Standard">
    <arg name="basepath" value="." />
    <arg name="colors"/>
    <arg name="extensions" value="php" />
    <arg value="sp"/>
    <config name="testVersion" value="8.1-"/>
    <description>Coding Standards for PHP CodeSniffer</description>
    <exclude-pattern>*/vendors/symfony/*</exclude-pattern>
    <file>./assets/blocks</file>
    <file>./config</file>
    <file>./plugin</file>
    <file>./templates</file>
    <file>./vendors</file>
    <file>./views</file>
    <file>./autoload.php</file>
    <file>./compatibility.php</file>
    <file>./helpers.php</file>
    <file>./migration.php</file>
    <file>./site-reviews.php</file>
    <file>./uninstall.php</file>
    <ini name="memory_limit" value="512M"/>
    <rule ref="vendor/pryley/wp-plugin-tooling/rulesets/compat.xml"/>
    <!-- The bundled libraries are updated from upstream, never edited. -->
    <rule ref="PHPCompatibility.ParameterValues.RemovedProprietaryCSVEscaping">
        <exclude-pattern>*/vendors/*</exclude-pattern>
    </rule>
    <rule ref="PHPCompatibility.ParameterValues.RemovedTriggerErrorLevel">
        <exclude-pattern>*/vendors/*</exclude-pattern>
    </rule>
</ruleset>
